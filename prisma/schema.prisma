generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  precon
  active
  paused
  closed
}

enum VarianceType {
  scope
  schedule
  labor
  cost
  quality
  legal
  hidden_condition
  client_request
  client_decision
}

enum ChangeOrderRequirement {
  yes
  no
  unknown
}

enum TaskStatus {
  planned
  completed
  incomplete
  blocked
}

enum AlertType {
  PAYMENT_RISK
  SEQUENCE_VIOLATION
  PREREQUISITE_FAILURE
  FALSE_PROGRESS
  UNOWNED_BLOCKER
  MISSING_PHOTOS
  UNREALISTIC_TOMORROW
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Project {
  id                 String        @id
  name               String
  clientName         String
  address            String
  status             ProjectStatus @default(precon)
  currentPhase       String        @default("")
  plannedStartDate   String?
  plannedEndDate     String
  projectManager     String?
  fieldLead          String?
  scheduleSource     String?
  scheduleFileName   String?
  scheduleImportedAt String?
  actualEndDate      String?

  scheduleRevisions ScheduleRevision[]
  scheduleTasks     ScheduleTask[]
  dailyBoardTasks   DailyBoardTask[]
  dailyBoardPhotos  DailyBoardPhoto[]
  fieldReports      FieldReport[]
  changeOrderDrafts ChangeOrderDraft[]
  alerts            Alert[]
}

model ScheduleRevision {
  id           String  @id
  projectId    String
  revisionNo   Int
  isBaseline   Boolean @default(false)
  isActive     Boolean @default(false)
  importedAt   String
  importedFrom String
  fileName     String?
  reason       String?
  taskCount    Int     @default(0)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ScheduleTask[]

  @@unique([projectId, revisionNo])
}

model ScheduleTask {
  id            String  @id
  revisionId    String
  projectId     String
  taskName      String
  phaseCode     String
  area          String  @default("")
  plannedStart  String  @default("")
  plannedFinish String  @default("")
  owner         String  @default("")
  dependency    String  @default("")
  milestone     Boolean @default(false)
  sourceNotes   String?
  readinessNote String?
  needsPmFill   Boolean @default(false)

  revision ScheduleRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DailyBoardTask {
  id                  String  @id
  projectId           String
  boardDate           String
  phaseCode           String
  area                String  @default("")
  taskName            String
  owner               String  @default("")
  plannedHours        Float   @default(0)
  readinessDependency String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DailyBoardPhoto {
  id         String  @id
  projectId  String
  boardDate  String
  fileName   String
  storageKey String
  notes      String?
  uploadedAt String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FieldReport {
  id                      String   @id
  projectId               String
  reportDate              String
  submittedBy             String
  crewMembers             String[] @default([])
  plannedTaskIds          String[] @default([])
  blockers                String[] @default([])
  tomorrowRecommendations String   @default("")
  createdAt               String

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  laborEntries      LaborEntry[]
  tasks             FieldTask[]
  variances         Variance[]
  photos            PhotoRecord[]
  changeOrderDrafts ChangeOrderDraft[]
  alerts            Alert[]
}

model LaborEntry {
  id            String  @id
  fieldReportId String
  employeeName  String
  phaseCode     String
  hours         Float
  notes         String?

  fieldReport FieldReport @relation(fields: [fieldReportId], references: [id], onDelete: Cascade)
}

model FieldTask {
  id            String     @id
  fieldReportId String
  boardTaskId   String?
  phaseCode     String
  area          String     @default("")
  taskName      String
  status        TaskStatus
  note          String?

  fieldReport FieldReport @relation(fields: [fieldReportId], references: [id], onDelete: Cascade)
}

model PhotoRecord {
  id                String  @id
  fieldReportId     String
  fileName          String
  storageKey        String
  caption           String  @default("")
  relatedVarianceId String?

  fieldReport FieldReport @relation(fields: [fieldReportId], references: [id], onDelete: Cascade)
}

model Variance {
  id                             String                 @id
  fieldReportId                  String
  type                           VarianceType
  description                    String
  discoveredBy                   String                 @default("")
  discoveredAt                   String
  affectedArea                   String                 @default("")
  relatedPhotoIds                String[]               @default([])
  estimatedLaborImpactHours      Float                  @default(0)
  estimatedMaterialImpactDollars Float                  @default(0)
  estimatedScheduleImpactDays    Float                  @default(0)
  requiresChangeOrder            ChangeOrderRequirement @default(unknown)
  clientNotified                 Boolean                @default(false)
  internalNotes                  String                 @default("")

  fieldReport       FieldReport        @relation(fields: [fieldReportId], references: [id], onDelete: Cascade)
  changeOrderDrafts ChangeOrderDraft[]
}

model ChangeOrderDraft {
  id                       String  @id
  projectId                String
  fieldReportId            String
  varianceId               String
  coNumber                 String  @default("")
  title                    String
  aiSummary                String  @default("")
  estimatedLaborHours      Float   @default(0)
  laborRateDollars         Float   @default(0)
  estimatedMaterialDollars Float   @default(0)
  estimatedScheduleDays    Float   @default(0)
  reviewStatus             String  @default("pm_review_required")
  approvedBy               String?
  approvedAt               String?
  createdAt                String

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldReport FieldReport @relation(fields: [fieldReportId], references: [id], onDelete: Cascade)
  variance    Variance    @relation(fields: [varianceId], references: [id], onDelete: Cascade)
}

model Alert {
  id             String        @id
  projectId      String
  fieldReportId  String?
  alertType      AlertType
  severity       AlertSeverity
  status         AlertStatus   @default(OPEN)
  title          String
  detail         String
  actionRequired String
  createdAt      String
  resolvedAt     String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fieldReport FieldReport? @relation(fields: [fieldReportId], references: [id], onDelete: SetNull)
}
